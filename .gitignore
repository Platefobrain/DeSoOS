/build/
target/

# Compiled Python (made when the test servers import each other)
__pycache__/
*.pyc

# QEMU disk images (made on the first run)
*.img

# Test logs
*.log

# Editor / system files
*~
*.swp
.vscode/
.idea/
.DS_Store

# Private scripts and A/B measurements
/ab/
ab-usb.sh
.build-local.sh
.run-local.sh
